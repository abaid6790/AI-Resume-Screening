# Copy this file to .env and fill in real values. .env is git-ignored.

FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-string

#
GEMINI_API_KEY= YOUR-GEMINI_API_KEY-HERE
GEMINI_MODEL=gemini-2.0-flash

LOG_LEVEL=INFO

# Email verification
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@resume-screening.local
