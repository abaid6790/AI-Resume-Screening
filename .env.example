#Paste this as it is to the env and replace the gemini api key with the original one and add the secret key
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-string

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

LOG_LEVEL=INFO
# Email verification
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@resume-screening.local
