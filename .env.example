# Copy this file to .env and fill in real values. .env is git-ignored.

FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-string

# SQLite is used automatically if DATABASE_URL is left unset (recommended).
# Only set this if you're pointing at Postgres/MySQL in production — a
# relative sqlite path here is fragile across OSes/working directories.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required from Phase 4 onward (AI screening)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

LOG_LEVEL=INFO

# Email verification (leave MAIL_SERVER blank in development — verification
# links are logged to the console/app.log instead of emailed)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@resume-screening.local
